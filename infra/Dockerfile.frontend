FROM node:22.14.0-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages packages
RUN npm ci
COPY tsconfig.json tsconfig.base.json ./
RUN npm run build --workspace=@cathay/intent-sentinel-frontend

FROM nginxinc/nginx-unprivileged:1.27.1-alpine
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/packages/frontend/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget -qO- http://127.0.0.1:8080/healthz || exit 1
